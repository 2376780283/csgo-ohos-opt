# VPC MASTER MAKEFILE


ifneq "$(LINUX_TOOLS_PATH)" ""
TOOL_PATH = $(LINUX_TOOLS_PATH)/
SHELL := $(TOOL_PATH)bash
else
SHELL := /bin/bash
endif

ifdef MAKE_CHROOT
    ifneq ("$(wildcard /etc/schroot/chroot.d/$(MAKE_CHROOT).conf)","")
        export CHROOT_NAME ?= $(MAKE_CHROOT)
    endif
    export CHROOT_NAME ?= $(subst /,_,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
    CHROOT_CONF := /etc/schroot/chroot.d/$(CHROOT_NAME).conf
    ifeq "$(CHROOT_NAME)" "steamrt_scout_amd64"
        CHROOT_DIR := /var/chroots
    else
        CHROOT_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/tools/runtime/linux)
    endif
    RUNTIME_NAME ?= steamrt_scout_amd64
    ifneq ("$(SCHROOT_CHROOT_NAME)", "$(CHROOT_NAME)")
        SHELL:=schroot --chroot $(CHROOT_NAME) -- /bin/bash
    endif

    CHROOT_TARBALL = $(CHROOT_DIR)/$(RUNTIME_NAME).tar.xz
    CHROOT_TIMESTAMP_FILE = $(CHROOT_DIR)/$(RUNTIME_NAME)/timestamp

    ifneq ("$(wildcard $(CHROOT_TARBALL))","")
        CHROOT_DEPENDENCY = $(CHROOT_CONF)
    endif
endif

ECHO = $(TOOL_PATH)echo
ETAGS = $(TOOL_PATH)etags
FIND = $(TOOL_PATH)find
UNAME = $(TOOL_PATH)uname
XARGS = $(TOOL_PATH)xargs

DOCKER_EXEC :=
ifeq (${USE_DOCKER},1)
    # We want to use docker. Are we already in the container? If so, nothing more to do.
    ifneq ($(IN_DOCKER_BUILD),1)
        DOCKER_ENV_LIST := CFG MAKE_JOBS MAKE_VERBOSE P4CONFIG P4PORT P4USER P4CLIENT
        DOCKER_ENV_VARS := $(foreach var,$(DOCKER_ENV_LIST), -e $(var)=$($(var)))
        DOCKER_EXEC := $(shell echo docker run -i --rm -v `echo ~`:`echo ~` -v $(PWD)/..:$(PWD)/.. $(DOCKER_ENV_VARS) -w $$PWD -v /etc/group:/etc/group:ro -v /etc/passwd:/etc/passwd:ro -u=$$UID:$$(id -g $$USER) -h=`hostname` build_csgo_server:latest) dumb-init
    endif
endif

# to control parallelism, set the MAKE_JOBS environment variable
ifeq ($(strip $(MAKE_JOBS)),)
    ifeq ($(shell $(UNAME)),Darwin)
        CPUS := $(shell /usr/sbin/sysctl -n hw.ncpu)
    endif
    ifeq ($(shell $(UNAME)),Linux)
        CPUS := $(shell $(TOOL_PATH)grep processor /proc/cpuinfo | $(TOOL_PATH)wc -l)
    endif
    MAKE_JOBS := $(CPUS)
endif

ifeq ($(strip $(MAKE_JOBS)),)
    MAKE_JOBS := 8
endif

# All projects (default target)
all: $(CHROOT_DEPENDENCY)
	$(DOCKER_EXEC) $(MAKE) -f $(lastword $(MAKEFILE_LIST)) -j$(MAKE_JOBS) all-targets

all-targets : launcher appframework interfaces tier0 tier1 tier2 tier3 vstdlib engine bitmap Bzip2 Dmxloader mathlib matsys_controls quickhull soundsystem_lowlevel vgui_controls videocfg vtf filesystem_stdio vpklib inputsystem vphysics havana_constraints hk_base hk_math ivp_compactbuilder ivp_physics materialsystem shaderlib shaderapidx9 datacache studiorender soundemittersystem vaudio_minimp3 SceneFileCache vscript vguimatsurface vgui_surfacelib vgui2 localize stdshader_dbg stdshader_dx9 panorama panorama_s1wrapper resourcefile panoramauiclient panorama_client panorama_text_pango Matchmaking_CSGO gcsdk matchmakingbase Client_Panorama_CSGO bonesetup choreoobjects mathlib_extended meshutils particles Raytrace Server_CSGO kv3lib responserules_runtime 


